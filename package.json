{
  "name": "collabmarkdown",
  "version": "1.0.0",
  "description": "基于 WebSocket 的多人实时协同 Markdown 编辑器 Web 应用，支持左右分栏实时预览、多用户光标标识、文档版本历史与快捷键操作。",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"nodemon server.js\" \"cd client && npm run dev\"",
    "build": "cd client && npm install && npm run build",
    "server": "nodemon server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gy-vs/CollabMarkdown.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gy-vs/CollabMarkdown/issues"
  },
  "homepage": "https://github.com/gy-vs/CollabMarkdown#readme",
  "dependencies": {
    "concurrently": "^7.6.0",
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "uuid": "^8.3.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
